# Build artifacts
/build/
/dist/
**/dist/
# [Cleanup 2026-08-27] 根 public/ 是旧 Cloudflare Worker 直出的过期静态快照，
# 已随 deploy.yml / deploy-cloudflare.yml 一并退役，防止再次提交进库。
/public/
# [Deploy Fix] 移除 !apps/web/dist/ 例外——提交的过期构建产物会让
# Vercel Next.js builder 找不到 dist/routes-manifest.json；静态导出产物
#（out/）属于构建产物，一律不进版本库。
apps/web/out/
*.tsbuildinfo

# Dependencies
/node_modules/
**/node_modules/
/.pnpm/
.pnpm-store/

# Environment
# [Low Fix #66] .env files are properly gitignored.
# SECURITY: Never commit real secret values. Always use placeholders.
# Environment files (.env, .env.local, .env.*.local) contain sensitive data.
.env
.env.local
.env.*.local

# Testing & Coverage
/coverage/

# Framework
/.next/
/.turbo/
/.vercel/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Backup
*.bak.js
*.tmp.js

# Contract build artifacts
apps/contracts/artifacts/
apps/contracts/cache/
apps/contracts/typechain-types/
apps/contracts/typechain/
apps/contracts/deployments/*/solcInputs/

# Subgraph build
apps/subgraph/build/
apps/subgraph/generated/
apps/subgraph/node_modules/

# Data sync
/data-sync/node_modules/
/data-sync/dist/
/data-sync/prisma/migrations/
/data-sync/db/

# API
/apps/api/.next/
/apps/api/dist/

# Misc
packages/*/dist/
packages/*/node_modules/

# Forta agents
forta-agents/*/dist/
forta-agents/*/node_modules/

# Deployment artifacts (contain live contract addresses, tx hashes, roles, storage layouts)
apps/contracts/deployments/*
!apps/contracts/deployments/.gitkeep
apps/contracts/.openzeppelin/*
!apps/contracts/.openzeppelin/.gitkeep
# Also catch root-level deployments/ fallback
deployments/

# Hardhat build artifacts (contain full ABI — information exposure risk)
apps/contracts/artifacts/

# K8s secrets — NEVER commit unsealed secrets (templates are OK)
k8s/*-sealed-secret.yaml
!k8s/*-sealed-secret.yaml.template

# Data sync env
data-sync/.env

# Generated data files (synced at runtime, must not be committed)
data-publisher/synced-addresses.json

# Wallet files (contain sensitive mnemonic phrases)
.wallet-*.json

# [L-29/L-30 Fix] Additional sensitive file patterns
*.key
*.pem
*.p12
*.pfx
*.crt
.ssh/
.vercel/
.env.glm52
*.env.*
.env

# [INFO-2 FIX] 运行时产物与内部开发文件（不入库）
data-sync/logs/
data-sync/cache/
memory/
.openclaw-model-router.json
.deploy-trigger
.vercel-redeploy

# [审计验证临时产物] 本地编译/测试验证用的临时目录与配置（不入库）
apps/contracts/hardhat.config.v*.js
apps/contracts/hardhat.config.verify.js
apps/contracts/cache-v*/
apps/contracts/artifacts-v*/
apps/contracts/cache-verify/
apps/contracts/artifacts-verify/
tscheck.json
compile-out.txt
compile-out.trash
tscheck.json.trash
*.trash
__pycache__/
