{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["contracts/**/*.sol", "test/**/*.ts"],
  "exclude": ["node_modules", "scripts", "artifacts", "cache", "typechain-types"]
}
