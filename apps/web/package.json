{
  "name": "@fidesorigin/web",
  "version": "3.3.4",
  "_versionNotes": "站点版本与根发布版本 3.3.4 对齐；SDK 使用独立的包版本号。",
  "private": true,
  "description": "FidesOrigin Next.js Web Application",
  "browserslist": [
    "chrome >= 110",
    "edge >= 110",
    "firefox >= 110",
    "safari >= 16"
  ],
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/fetch-metrics.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:style": "python _verify.py && python _crosscheck.py",
    "perf:budget": "node scripts/perf-budget.mjs",
    "clean": "rm -rf .next dist",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@fidesorigin/ui": "workspace:*",
    "next": "15.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "15.5.29",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.0.3",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.9.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0"
  }
}
