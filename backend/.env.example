# ============================================================
# FidesOrigin Production Environment Variables
# 复制此文件为 .env 并填入实际值后部署
# ============================================================

# ==================== 应用基础配置 ====================
APP_NAME=FidesOrigin
APP_VERSION=2.0.0
# 必须是 production，否则安全校验会失败
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# ==================== 数据库配置 ====================
# 这些在 docker-compose 中会被覆盖为服务名，但本地调试时有用
DB_HOST=postgres
DB_PORT=5432
DB_USER=fidesorigin
# ⚠️ 生产环境必须设置强密码（不要留空）
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE
DB_NAME=fidesorigin
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# 同步数据库 URL（Alembic 迁移使用）
# 格式: postgresql://user:password@host:port/dbname
DATABASE_URL_SYNC_VALUE=postgresql://fidesorigin:YOUR_STRONG_DB_PASSWORD_HERE@postgres:5432/fidesorigin

# ==================== Redis 配置 ====================
REDIS_HOST=redis
REDIS_PORT=6379
# ⚠️ 生产环境建议设置 Redis 密码
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false
REDIS_POOL_SIZE=50
REDIS_POOL_TIMEOUT=10

# ==================== 安全密钥（必须设置） ====================
# ⚠️ 生产环境必须设置 32 位以上随机字符串
SECRET_KEY=YOUR_32CHAR_PLUS_RANDOM_SECRET_KEY_HERE_CHANGE_THIS
# ⚠️ API 密钥，用于外部调用认证
API_KEY=YOUR_API_KEY_HERE_CHANGE_THIS
# ⚠️ HMAC 签名密钥，用于请求签名验证
HMAC_SECRET=YOUR_HMAC_SECRET_KEY_HERE_CHANGE_THIS
HMAC_ENABLED=true

# ==================== Admin 账号（必须设置） ====================
# ⚠️ 生产环境 Admin 用户名 — 必须设置（不设则登录端点拒绝服务，fail-closed）
ADMIN_USERNAME=admin
# ⚠️ 生产环境 Admin 密码 — 必须修改！
# 当前为占位符，系统启动时会检测并拒绝使用默认值
# 要求：至少12位，包含大小写字母、数字和特殊字符
# 推荐用 bcrypt 哈希值（更难被爆破）：python -c "import bcrypt;print(bcrypt.hashpw(b'你的密码',bcrypt.gensalt()).decode())"
ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ==================== Contact 收单通知（可选） ====================
# 新询盘的邮件通知。配置 RESEND_API_KEY 后启用；不配置则仅走 Webhook 通知。
# Resend：https://resend.com （HTTPS API，适合容器/Render 部署，无需 SMTP 端口）
RESEND_API_KEY=
# 询盘通知收件邮箱
CONTACT_NOTIFY_EMAIL=contact@fidesorigin.com
# 询盘 Webhook 通知地址（钉钉/Slack/飞书均可，复用 ALERT_WEBHOOK_URL）
# ALERT_WEBHOOK_URL 见上方告警配置段

# ==================== CORS 配置 ====================
# 生产环境逗号分隔，不允许使用 *
CORS_ORIGINS=https://fidesorigin.com,https://www.fidesorigin.com,https://fidesorigin-demo.vercel.app
CORS_ALLOW_CREDENTIALS=true

# ==================== Blockscout 配置 ====================
BLOCKSCOUT_BASE_URL=https://eth.blockscout.com/api/v2
BLOCKSCOUT_API_KEY=
BLOCKSCOUT_TIMEOUT=30
BLOCKSCOUT_RATE_LIMIT=5

# ==================== 风险引擎配置 ====================
RISK_CACHE_TTL=300
RISK_ENGINE_TIMEOUT=30

# ==================== 监控 / WebSocket 配置 ====================
MONITOR_WS_PING_INTERVAL=30
MONITOR_MAX_CONNECTIONS=100

# ==================== 告警配置 ====================
ALERT_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MINUTES=5

# ==================== 速率限制配置 ====================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
