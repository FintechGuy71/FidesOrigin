# k8s/kms-sealed-secret.yaml.template
# Sealed Secret template for KMS credentials (Bitnami Sealed Secrets)
#
# ⚠️  THIS IS A TEMPLATE ONLY. Never commit actual credentials to Git.
#     Actual credentials are injected via CI/CD (e.g., GitHub Actions + Sealed Secrets).
#
# Usage:
#   1. Fill in real values in a local copy (DO NOT commit):
#      cp k8s/kms-sealed-secret.yaml.template k8s/kms-sealed-secret.yaml
#
#   2. Generate the actual SealedSecret with kubeseal:
#      kubeseal --controller-namespace=sealed-secrets \
#        --controller-name=sealed-secrets \
#        --format yaml < k8s/kms-sealed-secret.yaml > k8s/kms-sealed-secret-sealed.yaml
#
#   3. Apply the sealed secret:
#      kubectl apply -f k8s/kms-sealed-secret-sealed.yaml
#
#   4. Verify:
#      kubectl get secret fidesorigin-kms-credentials -n fidesorigin
#
# ⚠️  NEVER commit the unsealed (plain) secret to Git.
#     Only commit the sealed version (k8s/kms-sealed-secret-sealed.yaml).

apiVersion: v1
kind: Secret
metadata:
  name: fidesorigin-kms-credentials
  namespace: fidesorigin
  labels:
    app: fidesorigin-data-publisher
type: Opaque
stringData:
  # ──────────────────────────────────────────────────────────────────────
  # AWS KMS (primary)
  # ──────────────────────────────────────────────────────────────────────
  AWS_KMS_KEY_ID: "<PLACEHOLDER>"
  AWS_REGION: "<PLACEHOLDER>"
  AWS_ACCESS_KEY_ID: "<PLACEHOLDER>"
  AWS_SECRET_ACCESS_KEY: "<PLACEHOLDER>"

  # ──────────────────────────────────────────────────────────────────────
  # Azure Key Vault (optional)
  # ──────────────────────────────────────────────────────────────────────
  AZURE_KEY_VAULT_NAME: "<PLACEHOLDER>"
  AZURE_KEY_NAME: "<PLACEHOLDER>"
  AZURE_CLIENT_ID: "<PLACEHOLDER>"
  AZURE_CLIENT_SECRET: "<PLACEHOLDER>"
  AZURE_TENANT_ID: "<PLACEHOLDER>"

  # ──────────────────────────────────────────────────────────────────────
  # HashiCorp Vault (optional)
  # ──────────────────────────────────────────────────────────────────────
  VAULT_ADDR: "<PLACEHOLDER>"
  VAULT_TOKEN: "<PLACEHOLDER>"
  VAULT_KEY_PATH: "<PLACEHOLDER>"
  VAULT_EXPECTED_ADDRESS: "<PLACEHOLDER>"

  # ──────────────────────────────────────────────────────────────────────
  # GCP KMS (optional)
  # ──────────────────────────────────────────────────────────────────────
  GCP_KMS_KEY_PATH: "<PLACEHOLDER>"
  GOOGLE_APPLICATION_CREDENTIALS_JSON: "<PLACEHOLDER>"
