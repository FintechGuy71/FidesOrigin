{
  "name": "fidesorigin",
  "version": "2.6.1",
  "private": true,
  "_versionNotes": "Root package version tracks monorepo/git tags (v2.6.1). Contract VERSION constants are independent (1.2.x-1.3.x) — see apps/contracts/ for contract version line.",
  "description": "FidesOrigin — Programmable On-Chain Compliance Protocol (Monorepo)",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,sol,py}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,sol,py}\"",
    "lint:py": "cd backend && ruff check . && ruff format --check . && mypy .",
    "postinstall": "pnpm build --filter=@fidesorigin/shared --filter=@fidesorigin/config",
    "prepare": "husky"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "husky": "^9.0.0",
    "jsdom": "^25.0.0",
    "lint-staged": "^15.0.0",
    "msw": "^2.14.6",
    "prettier": "^3.5.0",
    "prettier-plugin-solidity": "^1.4.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "turbo": "^2.5.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@11.6.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "@napi-rs/canvas",
      "secp256k1",
      "keccak",
      "bcrypt",
      "esbuild",
      "protobufjs"
    ],
    "overrides": {
      "@chainlink/contracts": "1.3.0"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": ["eslint --fix", "prettier --write"],
    "*.{py}": ["ruff check --fix", "ruff format"],
    "*.{json,md,yaml,yml}": ["prettier --write"]
  },
  "dependencies": {
    "@chainlink/contracts": "^1.3.0",
    "immer": "^11.1.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
